#!/usr/bin/env python3
"""Keep the bottom dock a little above the screen edge.

The panel snaps to the edge, which cuts off its rounded corners. Once the
panel is on screen, move it up. Later snaps are put back the same way.
"""
import ctypes
import os
import time

X11 = ctypes.CDLL("libX11.so.6")


class Display(ctypes.Structure):
    pass


X11.XOpenDisplay.argtypes = [ctypes.c_char_p]
X11.XOpenDisplay.restype = ctypes.POINTER(Display)
X11.XDefaultRootWindow.argtypes = [ctypes.POINTER(Display)]
X11.XDefaultRootWindow.restype = ctypes.c_ulong
X11.XDefaultScreen.argtypes = [ctypes.POINTER(Display)]
X11.XDefaultScreen.restype = ctypes.c_int
X11.XDisplayHeight.argtypes = [ctypes.POINTER(Display), ctypes.c_int]
X11.XDisplayHeight.restype = ctypes.c_int
X11.XInternAtom.argtypes = [ctypes.POINTER(Display), ctypes.c_char_p, ctypes.c_int]
X11.XInternAtom.restype = ctypes.c_ulong
X11.XGetWindowProperty.argtypes = [
    ctypes.POINTER(Display),
    ctypes.c_ulong,
    ctypes.c_ulong,
    ctypes.c_long,
    ctypes.c_long,
    ctypes.c_int,
    ctypes.c_ulong,
    ctypes.POINTER(ctypes.c_ulong),
    ctypes.POINTER(ctypes.c_int),
    ctypes.POINTER(ctypes.c_ulong),
    ctypes.POINTER(ctypes.c_ulong),
    ctypes.POINTER(ctypes.c_void_p),
]
X11.XFree.argtypes = [ctypes.c_void_p]
X11.XGetGeometry.argtypes = [
    ctypes.POINTER(Display),
    ctypes.c_ulong,
    ctypes.POINTER(ctypes.c_ulong),
    ctypes.POINTER(ctypes.c_int),
    ctypes.POINTER(ctypes.c_int),
    ctypes.POINTER(ctypes.c_uint),
    ctypes.POINTER(ctypes.c_uint),
    ctypes.POINTER(ctypes.c_uint),
    ctypes.POINTER(ctypes.c_uint),
]
X11.XMoveWindow.argtypes = [ctypes.POINTER(Display), ctypes.c_ulong, ctypes.c_int, ctypes.c_int]
X11.XFlush.argtypes = [ctypes.POINTER(Display)]

GAP = 16


def window_property(display, window, name):
    actual_type = ctypes.c_ulong()
    actual_format = ctypes.c_int()
    count = ctypes.c_ulong()
    bytes_after = ctypes.c_ulong()
    data = ctypes.c_void_p()
    status = X11.XGetWindowProperty(
        display,
        window,
        X11.XInternAtom(display, name.encode(), False),
        0,
        64,
        False,
        0,
        ctypes.byref(actual_type),
        ctypes.byref(actual_format),
        ctypes.byref(count),
        ctypes.byref(bytes_after),
        ctypes.byref(data),
    )
    if status != 0 or not data or count.value == 0:
        return []
    if actual_format.value == 32:
        values = ctypes.cast(data, ctypes.POINTER(ctypes.c_ulong))
        result = [int(values[i]) for i in range(count.value)]
    elif actual_format.value == 8:
        result = [ctypes.string_at(data, count.value)]
    else:
        result = []
    X11.XFree(data)
    return result


def panel_window(display, root):
    for window in window_property(display, root, "_NET_CLIENT_LIST"):
        classes = window_property(display, window, "WM_CLASS")
        if not classes or b"xfce4-panel" not in classes[0]:
            continue
        root_return = ctypes.c_ulong()
        x = ctypes.c_int()
        y = ctypes.c_int()
        width = ctypes.c_uint()
        height = ctypes.c_uint()
        border = ctypes.c_uint()
        depth = ctypes.c_uint()
        X11.XGetGeometry(
            display,
            window,
            ctypes.byref(root_return),
            ctypes.byref(x),
            ctypes.byref(y),
            ctypes.byref(width),
            ctypes.byref(height),
            ctypes.byref(border),
            ctypes.byref(depth),
        )
        return window, x.value, y.value, int(width.value), int(height.value)
    return None


def main():
    display = X11.XOpenDisplay(os.environ.get("DISPLAY", ":1").encode())
    if not display:
        return
    root = X11.XDefaultRootWindow(display)
    screen_h = int(X11.XDisplayHeight(display, X11.XDefaultScreen(display)))
    deadline = time.monotonic() + 20
    while time.monotonic() < deadline:
        found = panel_window(display, root)
        if found:
            window, x, y, width, height = found
            target = screen_h - height - GAP
            if y != target:
                X11.XMoveWindow(display, window, x, target)
                X11.XFlush(display)
            return
        time.sleep(0.2)


if __name__ == "__main__":
    main()
