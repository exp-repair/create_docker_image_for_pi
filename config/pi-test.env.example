# Multica 测试环境覆盖（可选）
# 复制为 pi-test.env 后，./scripts/run-test.sh 会优先读取它。
# 不复制也可以：run-test.sh 仍会用 config/pi.env 里的密钥，但把 Multica
# 服务地址改成测试 origin，避免连上正式 leagent.me。
#
#   cp config/pi-test.env.example config/pi-test.env
#
# 对应交互式：
#   multica setup --environment test \
#     --server-url https://82.157.184.89 \
#     --app-url https://82.157.184.89 \
#     /<workspace>

MULTICA_ENVIRONMENT=test
MULTICA_SERVER_URL=https://82.157.184.89
MULTICA_APP_URL=https://82.157.184.89
MULTICA_WORKSPACE_ID=
MULTICA_TOKEN=

# 测试镜像默认用 supervise，升级后从 $HOME/.local/bin/multica 交接并拉起。
MULTICA_DAEMON_ENABLED=1
MULTICA_DAEMON_MODE=supervise
MULTICA_DAEMON_SUPERVISE=1
