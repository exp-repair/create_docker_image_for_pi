# CoForge 环境选择（复制为 config/coforge.env 后生效）
#   cp config/coforge.env.example config/coforge.env
#
# COFORGE_ENV 对应 config/environments/<name>.env
# 也可用环境变量覆盖：COFORGE_ENV=production ./scripts/build-swarm.sh
#
# 若需临时改某个字段，可在本文件末尾追加同名变量，或在命令行 export。

COFORGE_ENV=staging

# 可选覆盖（取消注释后优先生效于 preset）：
# COFORGE_RELEASE_FEED_URL=https://releases-staging.coforge.cn
# COFORGE_CLOUD_HOST=https://staging.coforge.cn
# COFORGE_IMAGE_TAG=coforge-computer:staging
